# ==============================================================================
# AMIGOS MENS LUXURY PG — Backend Environment Configuration Example
# ==============================================================================

# Environment mode (development / production)
ENVIRONMENT=production

# Database URL
# For Docker Compose: postgresql://postgres:CHANGE_ME_DB_PASSWORD@db:5432/amigos_pg
# For Local Dev: sqlite:///./amigos_pg.db
DATABASE_URL=postgresql://postgres:CHANGE_ME_DB_PASSWORD@localhost:5432/amigos_pg

# JWT Authentication (Min 32 characters for production)
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_MIN_32_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# File Storage Configuration (local or s3)
STORAGE_BACKEND=local
UPLOAD_DIR=uploads
S3_BUCKET_NAME=
S3_REGION=us-east-1
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost", "http://localhost:80"]

# Admin Default Credentials (seeded on first startup)
ADMIN_DEFAULT_EMAIL=admin@amigospg.com
ADMIN_DEFAULT_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
ADMIN_DEFAULT_PHONE=9876543210

# Super Admin Default Credentials (seeded on first startup)
SUPERADMIN_DEFAULT_EMAIL=superadmin@amigospg.com
SUPERADMIN_DEFAULT_PASSWORD=CHANGE_ME_SUPERADMIN_PASSWORD
SUPERADMIN_DEFAULT_PHONE=9999999999
