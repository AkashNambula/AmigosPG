# ==============================================================================
# AMIGOS MENS LUXURY PG — Production Environment Configuration
# ==============================================================================
# Copy this file to .env before deploying:
#   cp .env.example .env
#
# IMPORTANT: Replace all CHANGE_ME_* values with strong, secure credentials!
# ==============================================================================

# Environment mode (development / production)
ENVIRONMENT=production

# Database Configuration (PostgreSQL in Docker Compose connects to service 'db')
DATABASE_URL=postgresql://postgres:CHANGE_ME_DB_PASSWORD@db:5432/amigos_pg

# PostgreSQL Container Credentials
POSTGRES_DB=amigos_pg
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD

# JWT Secret Key (MUST be at least 32 cryptographically random characters)
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_MIN_32_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Storage Engine (local filesystem or s3)
STORAGE_BACKEND=local
UPLOAD_DIR=uploads
S3_BUCKET_NAME=
S3_REGION=us-east-1
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# CORS Allowed Origins (JSON array or comma-separated list)
# Example: ["http://your-ec2-ip", "https://your-domain.com"]
CORS_ORIGINS=["http://localhost", "http://localhost:80"]

# Default PG Admin Credentials (seeded on startup)
ADMIN_DEFAULT_EMAIL=admin@amigospg.com
ADMIN_DEFAULT_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
ADMIN_DEFAULT_PHONE=9876543210

# Default Super Admin Credentials (seeded on startup)
SUPERADMIN_DEFAULT_EMAIL=superadmin@amigospg.com
SUPERADMIN_DEFAULT_PASSWORD=CHANGE_ME_SUPERADMIN_PASSWORD
SUPERADMIN_DEFAULT_PHONE=9999999999

# Frontend API URL (leave empty to use Nginx reverse proxy at /api on the same host)
VITE_API_URL=
