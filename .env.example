# Environment mode (development / production)
ENVIRONMENT=production

# Backend Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:CHANGE_ME_DB_PASSWORD@db:5432/amigos_pg

# JWT Authentication
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# File Storage Configuration (local or s3)
STORAGE_BACKEND=local
UPLOAD_DIR=uploads
S3_BUCKET_NAME=your-s3-bucket-name
S3_REGION=us-east-1
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

CORS_ORIGINS=["https://your-domain.com"]

# Admin Defaults
ADMIN_DEFAULT_EMAIL=admin@amigospg.com
ADMIN_DEFAULT_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
ADMIN_DEFAULT_PHONE=9876543210

# Postgres DB parameters for Docker
POSTGRES_DB=amigos_pg
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD

